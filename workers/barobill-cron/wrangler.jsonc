{
  // 바로빌 카드/계좌 무인 자동 동기화 트리거 워커.
  // Cloudflare Pages는 네이티브 cron이 없어, 별도 Worker가 매일 MES의 /api/cron/barobill-sync를 호출한다.
  // 실제 수집·dedup·자동상계 로직은 MES(Pages) 쪽에 그대로 — 이 워커는 트리거 전용(바로빌 CERTKEY 미보유).
  "name": "barobill-cron",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",

  // 분 시 일 월 요일 (UTC).
  //   0 21 * * *         = 06:00 KST 전체 회차(카드+계좌 → 일일정비 → 예산점검). 바로빌 야간 DAY1 수집 직후.
  //   0 0-20,22-23 * * * = 매시 정각 **계좌만**. 계좌 11개가 바로빌 HOUR1(월 4,400원)로 등록돼 있는데
  //                        하루 1회만 받아가고 있었다 → 이미 낸 요금을 쓰도록 맞춘 것(2026-08-11).
  //                        거래내역 조회는 무과금이라 추가 비용 없음. 21 시는 전체 회차와 겹쳐 제외.
  "triggers": { "crons": ["0 21 * * *", "0 0-20,22-23 * * *"] },

  "vars": {
    // 프로덕션 MES (apex, --branch main). self-fetch origin이 됨.
    "MES_URL": "https://webapp-9i0.pages.dev"
  },

  "observability": { "enabled": true }

  // secret(별도 설정 필요): AGENT_API_KEY  ← MES와 동일 값
  //   wrangler secret put AGENT_API_KEY  (workers/barobill-cron 디렉토리에서)
}
