<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="8.0" ExtensionBundleId="com.mes.a0.panel" ExtensionBundleVersion="2.0.0"
  ExtensionBundleName="MES Panel" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.mes.a0.panel.dock" Version="1.0.0" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="ILST" Version="[23.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="8.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.mes.a0.panel.dock">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./jsx/host.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--allow-file-access</Parameter>
            <Parameter>--allow-file-access-from-files</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>MES 가공·재단</Menu>
          <!-- 크기 실측 기준(2026-07-30). 기본 320×260 은 콘텐츠의 1/3 이라 첫 오픈에 [단건 가공]
               버튼(321~355px)과 결과창(362~418px)이 화면 밖이었다 = 성공했는지도 알 수 없는 상태.
               실측 콘텐츠 높이: 단건 접힘 469 · 단건 후가공 펼침 890 · 묶음 3행+펼침 1077.
               MinSize 220 폭에서는 마감 방식 드롭다운이 36px 로 줄어 이름이 안 읽혀 300 으로 올린다. -->
          <Geometry>
            <Size>
              <Height>640</Height>
              <Width>340</Width>
            </Size>
            <MinSize>
              <Height>320</Height>
              <Width>300</Width>
            </MinSize>
            <MaxSize>
              <Height>1200</Height>
              <Width>800</Width>
            </MaxSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
